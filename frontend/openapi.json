{
  "openapi": "3.1.0",
  "info": {
    "title": "Convoy",
    "description": "Workbench API for NEBULA X PS3: upload a subsystem's data, see what the checks and the model make of it, and download the prediction files.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/ps3/subsystems": {
      "get": {
        "tags": [
          "workbench"
        ],
        "summary": "Subsystems",
        "operationId": "subsystems_api_ps3_subsystems_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SubsystemInfo"
                  },
                  "type": "array",
                  "title": "Response Subsystems Api Ps3 Subsystems Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/ps3/subsystems/{subsystem}": {
      "get": {
        "tags": [
          "workbench"
        ],
        "summary": "Subsystem",
        "operationId": "subsystem_api_ps3_subsystems__subsystem__get",
        "parameters": [
          {
            "name": "subsystem",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "door",
                "acv",
                "rail",
                "shm"
              ],
              "type": "string",
              "title": "Subsystem"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubsystemInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ps3/runs": {
      "post": {
        "tags": [
          "workbench"
        ],
        "summary": "Create Run",
        "operationId": "create_run_api_ps3_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRun"
              }
            }
          },
          "required": true
