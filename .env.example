# Authenticate locally with `dagshub login`; never commit its token.
DAGSHUB_REPO_OWNER=kaz-uuu
DAGSHUB_REPO_NAME=lta-train-fault-detection

# Assistant: offline is explicit and needs no credentials.
# Vertex uses the Cloud Run service identity; no API key is required.
TFD_ASSISTANT_PROVIDER=offline
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
TFD_GEMINI_MODEL=gemini-2.5-flash

# Optional immutable model-version pins:
# TFD_MODEL_URI_DOOR=models:/door_resistance_classifier/1
# TFD_MODEL_URI_ACV=models:/acv_car_ranker/1
# TFD_MODEL_URI_RAIL=models:/rc_corrugation_classifier/1
# TFD_MODEL_URI_SHM=models:/shm_damage_regressor/1
